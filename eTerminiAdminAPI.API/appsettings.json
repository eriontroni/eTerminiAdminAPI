{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Vlerat e ndjeshme lihen bosh me qëllim — jepen nga variablat e mjedisit në prodhim
  // (p.sh. ConnectionStrings__DefaultConnection, Jwt__Key) ose nga appsettings.Development.json lokalisht.
  // KUJDES: DefaultConnection duhet të tregojë te E NJËJTA bazë si eTerminiAPI.
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Cache": {
    "AvailableSlotsTtlMinutes": 5,
    "InstanceName": "eTermini:"
  },
  "Reminders": {
    "PollIntervalMinutes": 5,
    "LeadTimeMinutes": 1440,
    "ToleranceMinutes": 30
  },
  // Jwt duhet të jetë identik me eTerminiAPI që tokenat të vlejnë në të dyja API-të.
  "Jwt": {
    "Key": "",
    "Issuer": "eTerminiAPI",
    "Audience": "eTerminiUI",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Auth": {
    "PasswordSalt": ""
  },
  "Cors": {
    // Origjinat e lejuara. Mbishkruhet me Cors__AllowedOrigins__0, __1, ...
    "AllowedOrigins": []
  },
  "Hosting": {
    // Vendos false kur aplikacioni rri prapa një reverse proxy që e mbyll TLS-in (Cloudflare Tunnel).
    "UseHttpsRedirection": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    // AdminAPI nuk migron — migrimet i aplikon eTerminiAPI mbi të njëjtën bazë.
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "AllowedHosts": "*"
}
